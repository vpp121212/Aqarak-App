{
  "installCommand": "npx puppeteer browsers install chrome || true && npm install --legacy-peer-deps",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "PUPPETEER_SKIP_DOWNLOAD": "true"
  }
}
